# Fails if any commit in BASE..HEAD, or PR_TITLE / PR_BODY, carries an
# AI-assistant attribution line.
# Usage: BASE=<sha> HEAD=<sha> [PR_TITLE=...] [PR_BODY=...] dev/check-ai-attribution

set -euo pipefail

pattern='co-authored-by:.*(claude|anthropic)|generated (with|by) \[?claude|noreply@anthropic\.com'

found=0
while read -r sha; do
  if git log -1 --format=%B "$sha" | grep -qiE "$pattern"; then
    echo "commit $(git log -1 --format='%h %s' "$sha") has an AI attribution line:"
    git log -1 --format=%B "$sha" | grep -iE "$pattern" | sed 's/^/  /'
    found=1
  fi
done < <(git rev-list "${BASE:?}..${HEAD:?}")

if printf '%s\n%s\n' "${PR_TITLE:-}" "${PR_BODY:-}" | grep -qiE "$pattern"; then
  echo "the PR title or body has an AI attribution line"
  found=1
fi

exit "$found"
